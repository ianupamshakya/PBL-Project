{
  "name": "kinship-circle",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:demo": "npm run dev:demo -w server",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "test:integration": "npm run test:integration -w server",
    "seed": "npm run seed -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
